# ==============================================================================
# Spark Lyric Studio — Environment Configuration
# Dual Mode: NVIDIA NVENC (RTX 2050 Local) & Ubuntu 24.04 Free-Tier CPU Server
# ==============================================================================

# MongoDB Atlas Connection String (Required)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Network & Host Binding
PORT=3000
HOST=0.0.0.0

# Video Encoder Selection: "auto" (default) | "nvenc" | "cpu"
# - "auto": Probes FFmpeg at startup. If NVIDIA NVENC is available (e.g. RTX 2050),
#           it uses fast hardware encoding. On Ubuntu free-tier VPS, it uses libx264.
# - "nvenc": Forces NVIDIA NVENC hardware acceleration (h264_nvenc).
# - "cpu": Forces CPU libx264 encoding with low-resource optimizations.
VIDEO_ENCODER=auto

# CPU Encoding Optimizations (for Ubuntu 24.04 Free-Tier / 1-2 vCPU VPS)
# Preset: "ultrafast", "superfast", "veryfast" (recommended), "faster"
CPU_PRESET=veryfast
CPU_CRF=23
# Threads: "0" (auto-detect all cores) or explicit number like "1" or "2"
CPU_THREADS=0

# Framerate Controls
# - NVENC automatically runs at 60 FPS
# - Low-resource CPU servers default to 30 FPS for 2x faster encoding
DEFAULT_FPS=60
MAX_FPS=60

# Audio Bitrate: "320k" (NVENC default), "192k" (low-CPU default)
AUDIO_BITRATE=320k

# YouTube OAuth Redirect URI Override (optional for public domain/IP on Ubuntu VPS)
# Default is http://localhost:3000/oauth2callback
# YOUTUBE_REDIRECT_URI=http://your-server-ip:3000/oauth2callback

# Optional custom FFmpeg path override (if installed in non-standard path)
# FFMPEG_PATH=/usr/bin/ffmpeg

# ==============================================================================
# Groq Cloud AI Integration (for Transliterating Hindi/Punjabi to English letters)
# ==============================================================================
# Model defaults to "openai/gpt-oss-120b" (with automatic fallback to llama-3.3-70b-versatile)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

